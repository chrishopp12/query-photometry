# -----------------------
# Python cache / artifacts
# -----------------------
__pycache__/
*.pyc

# -----------------------
# OS-specific junk
# -----------------------
.DS_Store

# -----------------------
# Data products (images, catalogs, tables)
# -----------------------
*.fits
*.fit
*.jpg
*.csv
*.ecsv
*.json
*.txt

# -----------------------
# Plots and figures
# -----------------------
*.png
*.pdf

# -----------------------
# Cache / output directories
# -----------------------
hst_cache/
*_output/
*_output_*/

# -----------------------
# Local configuration / credentials
# -----------------------
.env
config.*

# -----------------------
# Packaging artifacts
# -----------------------
*.egg-info/
build/
dist/

# Per-project working notes, local only. The glob also covers the
# "CLAUDE 2.md" conflict copies a syncing filesystem leaves behind, which
# carry the same private context as the original but match no bare filename.
CLAUDE*.md
session_log*.md

# -----------------------
# Documentation
# -----------------------
# LaTeX build products
*.aux
*.out
*.toc
docs/*.log
# The user manual ships built, so it is exempt from the *.pdf rule above.
!docs/sedphot_user_manual.pdf
